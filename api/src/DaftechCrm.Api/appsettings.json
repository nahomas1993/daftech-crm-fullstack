{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=daftech_crm;Username=postgres;Password=CHANGE_ME;"
  },
  "Cors": {
    "_comment": "Local development default only — matches ng serve's default port (see frontend/src/environments/environment.ts). Production overrides this via the Cors__AllowedOrigins__0 environment variable (see appsettings.Production.json) — Render deploys MUST set that env var explicitly; do not put a real production URL here, since ASP.NET Core's config layering does not let an empty array in a higher-priority source clear an array already set here.",
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "DaftechCrm",
    "Audience": "DaftechCrm.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "TicketWorkflow": {
    "MinimumSatisfactionScore": 90,
    "ClientConfirmationWindowDays": 5
  },
  "Email": {
    "Provider": "Smtp"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UseStartTls": true,
    "Username": "CHANGE_ME",
    "Password": "CHANGE_ME",
    "FromAddress": "no-reply@daftech.et",
    "FromName": "DAFTECH CRM",
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 2
  },
  "BrevoApi": {
    "ApiKey": "CHANGE_ME",
    "ApiBaseUrl": "https://api.brevo.com/v3",
    "FromAddress": "no-reply@daftech.et",
    "FromName": "DAFTECH CRM",
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 2,
    "TimeoutSeconds": 15
  },
  "Storage": {
    "Provider": "LocalFileSystem",
    "RootPath": "storage/uploads",
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".png", ".jpg", ".jpeg", ".webm", ".ogg", ".m4a", ".mp3", ".wav" ],
    "MaxFileSizeBytes": 10485760
  },
  "Cloudinary": {
    "CloudName": "CHANGE_ME",
    "ApiKey": "CHANGE_ME",
    "ApiSecret": "CHANGE_ME",
    "Folder": "daftech-crm/ticket-attachments",
    "TimeoutSeconds": 20
  },
  "Session": {
    "OfflineAfterMinutes": 5
  }
}